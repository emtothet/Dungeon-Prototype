--- !u!114 &2053230835
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2053230834}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b100e1bf248797f49ab186aba3518627, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FantasyDungeonPixelPack.NPCDialogue
  speakerName: Elder Rowan
  portrait: {fileID: 1952507750863325824, guid: e603e528de3d9804dbb0a4948a00114e, type: 3}
  firstLines:
  - Thank the stars, a knight! The Slime King broke into the royal vault... and ATE
    the crown.
  - Swallowed it whole. Very round, very smug about it.
  - Our cellar is crawling with his slimes. Clear them out first - then take the
    shaft down to the dungeon.
  repeatLines:
  - The cellar, brave one. West side. Mind the damp.
  startObjectiveId: q1_cellar
  startObjectiveTitle: Clear the village cellar
  startObjectiveRequired: 3
  reportObjectiveId: 
  doneObjectiveId: q5_sking
  doneLines:
  - The crown! You actually got it back. And it only smells slightly of slime!
  - Oakhollow is in your debt, hero.
  bubbleLines:
  - Oh dear, oh dear...
  - The crown...
  bubbleInterval: 6
  bubbleRange: 5
